{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ethcoordinate-website",
	"compatibility_date": "2026-08-07",
	"assets": {
		"directory": "./dist"
	},
	"env": {
		"dev": {
			"name": "ethcoordinate-website-dev",
			"routes": [{ "pattern": "dev.ethcoordinate.org", "custom_domain": true }]
		}
	}
}
