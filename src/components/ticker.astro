---
import { site } from "../site";

/* Two identical lists make the track. The track slides left by half its own
   width, which is exactly one list. The second list is then where the first
   one started, so the loop has no seam. The trailing `pe-*` gives the last
   phrase of a list the same gap as the others, which keeps the halves
   equal. Each list repeats the phrases six times, so one list is wider than
   any viewport and no blank gap shows before the loop restarts. */
const phrases = Array.from({ length: 6 }, () => site.ticker).flat();
const lists = [false, true];
---

<div
	class="ticker bg-ticker text-ticker-body overflow-hidden py-5 text-[12px] font-extrabold tracking-[0.5px] whitespace-nowrap uppercase"
>
	<div class="track flex w-max">
		{
			lists.map((clone) => (
				<ul
					class="flex shrink-0 gap-10 pe-10 lg:gap-16 lg:pe-16"
					aria-hidden={clone ? "true" : undefined}
				>
					{phrases.map((phrase) => (
						<li>{phrase}</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.track {
		/* Six repeats per list need six times the old 20s to keep the speed. */
		animation: ticker 120s linear infinite;
		will-change: transform;
	}

	/* The pointer holds the line still, so a phrase can be read. A touch
	   screen has no real hover, and a tap would leave the bar stopped. */
	@media (hover: hover) {
		.ticker:hover .track {
			animation-play-state: paused;
		}
	}

	@keyframes ticker {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}
	}
</style>
