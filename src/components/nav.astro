---
import Logo from "./logo.astro";
import { site } from "../site";
---

<header
	class="border-subtle bg-surface sticky top-0 z-50 border-b transition-colors duration-200"
>
	<nav
		class="flex h-[var(--nav-height)] items-center justify-between px-4 sm:gap-8 sm:px-10 lg:px-16"
		aria-label={site.name}
	>
		<a
			href="#"
			class="press focus-visible:outline-accent inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
		>
			<span class="sr-only">{site.home}</span>
			<Logo class="h-8 w-auto sm:h-9" />
		</a>
		<ul class="hidden items-center gap-6 text-[15px] sm:flex sm:gap-10">
			{
				site.nav.map((link) => (
					<li>
						<a
							href={link.href}
							class="hover:text-accent press focus-visible:outline-accent inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<button
			id="nav-menu-button"
			type="button"
			popovertarget="nav-menu"
			aria-controls="nav-menu"
			aria-expanded="false"
			data-label-open={site.menu}
			data-label-close={site.menuClose}
			class="hover:text-accent press focus-visible:outline-accent -mr-3 cursor-pointer rounded-sm p-3 focus-visible:outline-2 focus-visible:outline-offset-2 sm:hidden"
		>
			<span class="sr-only">{site.menu}</span>
			{/* Figma draws the menu as two bars. They cross into an X on open. */}
			<span class="relative block size-5" aria-hidden="true">
				<span class="bar absolute inset-x-[3px] top-[6.5px] h-[1.5px] rounded-full bg-current"
				></span>
				<span class="bar absolute inset-x-[3px] top-[12px] h-[1.5px] rounded-full bg-current"
				></span>
			</span>
		</button>
	</nav>

	{/* The popover closes on Escape and on a tap outside. Both are native. */}
	<div
		id="nav-menu"
		popover
		class="border-subtle bg-surface text-body fixed inset-x-0 top-[var(--nav-height)] bottom-auto m-0 w-auto rounded-none border-0 border-b p-0 sm:hidden"
	>
		<ul>
			{
				site.nav.map((link) => (
					<li class="border-subtle border-t first:border-t-0">
						<a
							href={link.href}
							class="hover:text-accent press focus-visible:outline-accent block px-4 py-4 text-[15px] focus-visible:outline-2 focus-visible:-outline-offset-2"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<style>
	/* The menu slides down and fades in. `allow-discrete` holds the element on
	   screen while it leaves, so the exit plays too. */
	#nav-menu {
		opacity: 0;
		translate: 0 -0.5rem;
		transition:
			opacity 180ms ease-out,
			translate 180ms ease-out,
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}

	#nav-menu:popover-open {
		opacity: 1;
		translate: 0 0;
	}

	@starting-style {
		#nav-menu:popover-open {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}

	/* The invoker gets no open state in the DOM, so the header reports it. */
	.bar {
		transition:
			translate 180ms ease-out,
			rotate 180ms ease-out;
	}

	header:has(#nav-menu:popover-open) .bar:first-of-type {
		translate: 0 2.75px;
		rotate: 45deg;
	}

	header:has(#nav-menu:popover-open) .bar:last-of-type {
		translate: 0 -2.75px;
		rotate: -45deg;
	}

	@media (prefers-reduced-motion: reduce) {
		#nav-menu,
		.bar {
			transition-duration: 1ms;
		}
	}
</style>

<script>
	const menu = document.getElementById("nav-menu");
	const button = document.getElementById("nav-menu-button");
	const label = button?.querySelector("span");

	/* A link inside a popover does not close it. Close it here. */
	menu?.addEventListener("click", (event) => {
		if (event.target instanceof Element && event.target.closest("a")) {
			menu.hidePopover();
		}
	});

	/* A popover reports its state to the accessibility tree but not to the
	   DOM. Report it here, so the button also carries the state and the
	   right name. */
	menu?.addEventListener("toggle", (event) => {
		const open = (event as ToggleEvent).newState === "open";
		button?.setAttribute("aria-expanded", String(open));
		if (label && button) {
			label.textContent = open
				? (button.dataset.labelClose ?? "")
				: (button.dataset.labelOpen ?? "");
		}
	});
</script>
