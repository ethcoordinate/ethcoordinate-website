---
/* The three properties, in the shape of the org: EthCoordinate on top, with
   the initiatives it runs inside it, and EthStaker and Forkcast under it.
   The Products dropdown reads the same array. */
import PropertyColumn from "./property-column.astro";
import { site } from "../site";

const [umbrella, ...properties] = site.properties;
---

<div
	id="properties"
	class="border-subtle scroll-mt-[var(--nav-height)] lg:border-t"
>
	<PropertyColumn group={umbrella} band class="px-8 pt-[26px] pb-[30px]">
		<dl class="flex flex-col gap-10 pt-4">
			{
				site.whatWeDo.items.map(({ title, body }) => (
					<div class="flex flex-col lg:flex-row lg:gap-[60px]">
						<dt class="text-[28px] font-bold uppercase lg:w-[240px] lg:shrink-0 lg:text-right">
							{title}
						</dt>
						<dd class="text-[16px] leading-[1.45] lg:max-w-[386px] lg:flex-1">
							{body}
						</dd>
					</div>
				))
			}
		</dl>
	</PropertyColumn>

	<div class="border-subtle grid lg:grid-cols-2 lg:border-t">
		{
			properties.map((group) => (
				<PropertyColumn group={group} class="px-8 pt-[26px] pb-[30px]" />
			))
		}
	</div>
</div>
