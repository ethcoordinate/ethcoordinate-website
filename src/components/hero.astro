---
import glow from "../assets/hero-glow.webp";
import mark from "../assets/hero-mark.webp";
import Dots from "./dots.astro";
import { site } from "../site";

/* The Figma hero frame. Every decoration below is a position in this box.
   Percentages keep the layout at any width. */
const frame = { width: 1440, height: 726 };

const dots = [
	/* Figma puts this dot at 195.9, 288.9, where the drift lands it on the
	   heading. It sits higher here, clear of the glyphs. */
	{ x: 150, y: 195, size: 36, tone: "bg-dot-blue" },
	{ x: 401.9, y: 494.9, size: 20, tone: "bg-dot-light" },
	{ x: 1070.1, y: 444.7, size: 40.7, tone: "bg-dot-light" },
	{ x: 286.9, y: 423.9, size: 20, tone: "bg-dot-blue" },
	{ x: 1132.3, y: 343.9, size: 20, tone: "bg-dot-blue" },
	{ x: 1165.9, y: 548.9, size: 70, tone: "bg-dot-blue" },
	{ x: 73.9, y: 439.9, size: 30, tone: "bg-dot-blue" },
	{ x: 1363.9, y: 399.9, size: 30, tone: "bg-dot-blue" },
];
---

<section
	class="relative flex min-h-[calc(100svh-var(--nav-height))] items-center overflow-hidden px-4 pt-10 pb-5 lg:px-16 lg:pt-[90px] lg:pb-[100px]"
>
	{/* The glow box is twice as tall as the section, and the section clips it,
	   so only the top band of the artwork shows. `cover` then fills that box
	   at any aspect ratio, so no edge is ever left unpainted. The artwork is a
	   webp render of the Figma export. The export carried live SVG filters,
	   and the browser paid for them on every load. See docs/solutions. */}
	<div
		class="pointer-events-none absolute inset-x-0 top-0 h-[200%] bg-cover bg-top bg-no-repeat"
		style={{ backgroundImage: `url(${glow.src})` }}
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute hidden aspect-square w-[27.56%] bg-contain bg-no-repeat lg:block"
		style={{
			left: "35.39%",
			top: "0.3%",
			backgroundImage: `url(${mark.src})`,
		}}
		aria-hidden="true"
	>
	</div>

	{/* `z-10` keeps the copy above the drifting dots, which come later in the
	   DOM. */}
	<div
		class="relative z-10 mx-auto flex w-full max-w-[1312px] flex-col items-center gap-6 lg:gap-[26px]"
	>
		<p
			style="--n: 0"
			class="piece self-start text-[8px] font-bold tracking-[1px] whitespace-pre-line lg:text-[12px]"
		>
			{site.hero.eyebrow}
		</p>
		<h1
			style="--n: 1"
			class="piece flex flex-col items-center text-center font-bold tracking-[-2px] uppercase"
		>
			<span
				class="text-gradient text-[52px] leading-[0.96] font-extrabold lg:text-[76px]"
			>
				{site.hero.titleTop}
			</span>
			<span class="text-[39px] leading-[1.02] lg:text-[55px]">
				{site.hero.titleBottom}
			</span>
		</h1>
		<p
			style="--n: 2"
			class="piece max-w-[462px] text-center text-[14px] leading-[1.5] lg:text-[17px]"
		>
			{site.hero.body}
		</p>
		<div style="--n: 3" class="piece flex flex-col items-center gap-7">
			<a
				href={site.hero.ctaHref}
				class="bg-cta text-cta-body press focus-visible:outline-accent group inline-block rounded-full px-6 py-4 text-[14px] font-bold uppercase hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4"
			>
				{site.hero.ctaLabel}
				{/* The arrow is artwork, so it is drawn here, not in `site.ts`. It
				   points down and nudges toward the section it opens. */}
				<svg
					class="align-[-0.125em] ms-1.5 inline-block size-3.5 transition-transform duration-150 ease-out motion-safe:group-hover:translate-y-0.5 motion-safe:group-focus-visible:translate-y-0.5"
					viewBox="0 0 16 16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M8 2v11M3.5 9 8 13.5 12.5 9"></path>
				</svg>
			</a>
			<a
				href={site.hero.emailHref}
				class="hover:text-accent press group focus-visible:outline-accent inline-block rounded-sm text-[14px] font-bold underline focus-visible:outline-2 focus-visible:outline-offset-4"
			>
				{site.hero.emailLabel}
				{/* The arrow turns 45 degrees, so it morphs into a right arrow. */}
				<span
					class="inline-block transition-transform duration-150 ease-out motion-safe:group-hover:rotate-45 motion-safe:group-focus-visible:rotate-45"
					aria-hidden="true">{site.hero.emailArrow}</span
				>
			</a>
		</div>
	</div>

	<Dots frame={frame} dots={dots} />
</section>

<style>
	/* The hero is the one place that earns an entrance. Each piece rises,
	   fades, and sharpens, 90ms behind the piece above it. `--n` is the
	   order of the piece. */
	.piece {
		opacity: 0;
		translate: 0 8px;
		filter: blur(2px);
		animation: rise-in 350ms ease-out forwards;
		animation-delay: calc(var(--n, 0) * 90ms);
	}

	@keyframes rise-in {
		to {
			opacity: 1;
			translate: 0 0;
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.piece {
			opacity: 1;
			translate: 0 0;
			filter: none;
			animation: none;
		}
	}
</style>
