---
import { site } from "../site";
---

<section class="bg-glow px-5 pt-5 lg:px-16 lg:pt-28 lg:pb-32">
	<div class="mx-auto flex max-w-[82rem] flex-col gap-8 lg:gap-5">
		<div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:pb-12">
			<div class="flex flex-col gap-2 pt-4 lg:w-78 lg:shrink-0">
				<p class="text-[27.625px] font-bold tracking-[1.06px]">
					{site.faq.number}
				</p>
				<h2
					class="text-[32px] leading-[32px] font-extrabold tracking-[2.1px] uppercase lg:text-[56px] lg:leading-[56px]"
				>
					{site.faq.heading}
				</h2>
			</div>
			{/* The column is wide, the line is not. That pair is what breaks the
			   lead into two lines. */}
			<div class="lg:w-160">
				<p class="max-w-82 text-xl leading-[1.22] font-bold lg:text-[2.375rem]">
					{site.faq.lead}
				</p>
			</div>
			<p class="max-w-60 text-base leading-[1.5]">{site.faq.intro}</p>
		</div>

		<div class="lg:flex lg:gap-5">
			{/* The label column above holds the width. This spacer repeats it, so
			   the list starts under the copy. */}
			<div class="hidden lg:block lg:w-78 lg:shrink-0"></div>
			<div class="border-subtle flex-1 border-b">
				{
					site.faq.items.map(({ question, answer }, index) => (
						<details class="border-subtle border-t" open={index === 0}>
							{/* A full width row is too big to scale under the finger,
							   so it tints instead. */}
							<summary class="hover:text-accent flex cursor-pointer list-none items-center justify-between gap-5 py-6.5 text-[1.1875rem] leading-[1.45] font-bold transition-colors duration-200 [&::-webkit-details-marker]:hidden">
								<span>{question}</span>
								{/* Two strokes make the plus. The upright one turns flat
								   onto the other, so the mark becomes a minus without
								   ever leaving the screen. */}
								<svg
									class="mark size-4.5 shrink-0"
									viewBox="0 0 18 18"
									aria-hidden="true"
								>
									<line x1="2" y1="9" x2="16" y2="9" />
									<line class="bar" x1="9" y1="2" x2="9" y2="16" />
								</svg>
							</summary>
							<div class="panel">
								<p class="answer text-base leading-[1.5]">{answer}</p>
							</div>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* The row carries the height, the copy carries the fade. Splitting the two
	   is what keeps the open from reading as one block of text popping in.
	   Firefox never starts a transition on the `::details-content` pseudo
	   element, so a real wrapper carries the `0fr` to `1fr` track animation.
	   The pseudo element only keeps the content rendered; the collapsed track
	   is what hides a closed answer. */
	details::details-content {
		content-visibility: visible;
	}

	.panel {
		display: grid;
		grid-template-rows: 0fr;
		overflow: hidden;
		transition: grid-template-rows 200ms var(--ease-out);
	}

	/* The close stays a bit faster than the open. */
	details[open] .panel {
		grid-template-rows: 1fr;
		transition-duration: 260ms;
	}

	/* The padding moves with the row. Left on the box, it would hold a 26px
	   floor under every closed row in Firefox, because the track minimum
	   cannot shrink below the padding. */
	.answer {
		min-height: 0;
		padding-bottom: 0;
		opacity: 0;
		translate: 0 -0.5rem;
		transition:
			opacity 160ms ease,
			translate 160ms var(--ease-out),
			padding-bottom 200ms var(--ease-out);
	}

	/* The copy waits for the row to make room, so it never rises into a box
	   that is still closing. The padding keeps the row's own pace. */
	details[open] .answer {
		padding-bottom: calc(var(--spacing) * 6.5);
		opacity: 1;
		translate: 0 0;
		transition:
			opacity 160ms ease 60ms,
			translate 160ms var(--ease-out) 60ms,
			padding-bottom 260ms var(--ease-out);
	}

	.mark {
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	/* `fill-box` is what puts the origin at the middle of the stroke. Without
	   it the line swings around the corner of the SVG. */
	.bar {
		transform-box: fill-box;
		transform-origin: center;
		transition: rotate 260ms var(--ease-out);
	}

	details[open] .bar {
		rotate: 90deg;
	}

	/* Reduced motion keeps the fade, which explains the change, and drops every
	   move. */
	@media (prefers-reduced-motion: reduce) {
		.panel,
		.bar {
			transition: none;
		}

		.answer {
			translate: none;
			transition: opacity 160ms ease;
		}
	}
</style>
