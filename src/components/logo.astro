---
/* References the artwork in `LogoSprite.astro`. That sprite must be on the
   page. */
import { site } from "../site";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	width="189"
	height="44"
	viewBox="0 0 189 44"
	fill="none"
	role="img"
	aria-label={site.name}
>
	<use href="#ec-logo"></use>
</svg>
