---
import Dots from "./dots.astro";
import { site } from "../site";

interface Props {
	/* A sub page sets its own copy. The home page takes the default. */
	cta?: {
		eyebrow: string;
		heading: string;
		emailHref: string;
		emailLabel: string;
	};
}

const { cta = site.cta } = Astro.props;

/* The Figma frame. Every decoration below is a position in this box. */
const frame = { width: 1440, height: 530 };

const dots = [
	{ x: 89, y: 53, size: 30 },
	{ x: 362, y: 70, size: 10 },
	{ x: 1038, y: 76, size: 10 },
	{ x: 281, y: 152, size: 36 },
	{ x: 462, y: 197, size: 20 },
	{ x: 1143, y: 352, size: 36 },
	{ x: 616, y: 413, size: 36 },
	{ x: 416.9, y: 427.9, size: 20, tone: "bg-dot-light" },
	{ x: 1181, y: 482, size: 70 },
	/* The one dot that stands on its corner. */
	{ x: 1245.5, y: 129.6, size: 16.41, diamond: true },
];
---

<section class="relative overflow-hidden px-5 pt-13 pb-20 lg:pt-17 lg:pb-44">
	<div class="bg-cta-glow pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

	{/* The ellipse holds its own frame at each breakpoint, because Figma scales
	   it by half on a small screen but keeps the same dash. `slice` pins it to
	   the middle, whatever height the copy gives the section. */}
	<svg
		class="text-cta-dash pointer-events-none absolute inset-0 size-full lg:hidden"
		viewBox="0 0 393 393"
		preserveAspectRatio="xMidYMid slice"
		fill="none"
		stroke="currentColor"
		stroke-dasharray="5 4"
		aria-hidden="true"
	>
		<ellipse
			cx="195.84"
			cy="223.58"
			rx="229.96"
			ry="107.31"
			transform="rotate(8 195.84 223.58)"></ellipse>
	</svg>
	<svg
		class="text-cta-dash pointer-events-none absolute inset-0 hidden size-full lg:block"
		viewBox="0 0 1440 530"
		preserveAspectRatio="xMidYMid slice"
		fill="none"
		stroke="currentColor"
		stroke-dasharray="5 4"
		aria-hidden="true"
	>
		<ellipse
			cx="707.85"
			cy="259.58"
			rx="449.5"
			ry="209.5"
			transform="rotate(8 707.85 259.58)"></ellipse>
	</svg>

	<div class="relative z-10 flex flex-col items-center gap-4 text-center">
		{/* The wordmark carries the mark in its first 44 units. The `use` holds
		   the full size of the sprite and the viewBox crops it to that part, so
		   the band needs no second asset. */}
		<svg class="h-19 w-18.5" viewBox="0 0 44 44" fill="none" aria-hidden="true">
			<use href="#ec-logo" width="189" height="44"></use>
		</svg>

		<div class="flex flex-col items-center gap-4 pt-4">
			<p class="text-[0.8125rem] font-bold tracking-[0.0625rem] uppercase">
				{cta.eyebrow}
			</p>
			<h2
				class="text-gradient-cta max-w-220 text-2xl leading-[1.16] font-extrabold uppercase lg:text-5xl"
			>
				{cta.heading}
			</h2>
			<a
				href={cta.emailHref}
				class="hover:text-accent press focus-visible:outline-accent inline-block rounded-sm text-base underline decoration-solid underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-4 lg:text-xl"
			>
				{cta.emailLabel}
			</a>
		</div>
	</div>

	<Dots frame={frame} dots={dots} />
</section>
