---
import Logo from "./logo.astro";
import { site } from "../site";
---

<footer
	class="border-subtle bg-surface border-t transition-colors duration-200"
>
	<div
		class="flex flex-col items-center gap-6 px-6 py-8 text-center sm:flex-row sm:justify-between sm:gap-8 sm:px-10 sm:text-left lg:px-16"
	>
		<Logo class="h-9 w-auto sm:h-11" />
		<p class="text-sm">{site.footer.tagline}</p>
		<p class="text-[13px]">{site.footer.copyright}</p>
	</div>
</footer>
