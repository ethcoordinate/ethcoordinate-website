---
import DiscordIcon from "../icons/discord.svg";
import Logo from "./logo.astro";
import { routes } from "../routes";
import { site } from "../site";

/* The footer only shows the Discord profile. */
const discord = site.networks.find((n) => n.key === "discord");
---

<footer
	class="border-subtle bg-surface border-t transition-colors duration-200"
>
	{/* The DOM keeps the Figma phone order. `order` restores the row order. */}
	<div
		class="flex flex-col items-center gap-[30px] px-6 py-8 text-center sm:flex-row sm:justify-between sm:gap-8 sm:px-10 sm:text-left lg:px-16"
	>
		<p class="text-sm sm:order-2">{site.footer.tagline}</p>
		<a
			href={routes.top}
			class="press focus-visible:outline-accent inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 sm:order-1"
		>
			<span class="sr-only">{site.home}</span>
			<Logo class="h-9 w-auto sm:h-11" />
		</a>
		<div class="flex flex-col items-center gap-4 sm:order-3 sm:flex-row">
			<p class="text-[13px]">{site.footer.copyright}</p>
			{
				discord && (
					<a
						href={discord.href}
						target="_blank"
						rel="noreferrer"
						class="border-subtle bg-surface hover:text-accent press focus-visible:outline-accent grid size-9 place-items-center rounded-full border-[1.5px] focus-visible:outline-2 focus-visible:outline-offset-2"
						aria-label={discord.label}
					>
						<DiscordIcon class="size-5" aria-hidden="true" />
					</a>
				)
			}
		</div>
	</div>
</footer>
