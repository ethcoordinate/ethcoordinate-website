---
import Logo from "./Logo.astro";
import { site } from "../site";
---

<header
	class="border-subtle bg-surface sticky top-0 z-50 border-b transition-colors duration-200"
>
	<nav
		class="flex flex-col items-center gap-4 px-6 py-4 sm:flex-row sm:justify-between sm:gap-8 sm:px-10 sm:py-6 lg:px-16"
		aria-label={site.name}
	>
		<a
			href="#top"
			class="focus-visible:outline-accent rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
		>
			<span class="sr-only">{site.home}</span>
			<Logo class="h-9 w-auto sm:h-11" />
		</a>
		<ul class="flex items-center gap-6 text-[15px] sm:gap-10">
			{
				site.nav.map((link) => (
					<li>
						<a
							href={link.href}
							class="hover:text-accent focus-visible:outline-accent rounded-sm transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
