---
import Cta from "../components/cta.astro";
import Hero from "../components/hero.astro";
import Base from "../layouts/base.astro";
import { site } from "../site";

/* URL values serialize to strings, because URL has a toJSON method. */
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	name: site.name,
	url: Astro.site,
	logo: new URL("/favicon.svg", Astro.site),
	email: site.hero.emailLabel,
	description: site.pages.home.description,
	sameAs: site.networks.map((n) => n.href),
});
---

<Base page={site.pages.home}>
	<script is:inline type="application/ld+json" slot="head" set:html={jsonLd} />
	<Hero />
	<Cta />
</Base>
