---
import About from "../components/about.astro";
import Community from "../components/community.astro";
import Cta from "../components/cta.astro";
import Faq from "../components/faq.astro";
import Hero from "../components/hero.astro";
import Team from "../components/team.astro";
import WhatWeDo from "../components/what-we-do.astro";
import Base from "../layouts/base.astro";
import { site } from "../site";

/* URL values serialize to strings, because URL has a toJSON method. */
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	name: site.name,
	url: Astro.site,
	logo: new URL("/favicon.svg", Astro.site),
	email: site.hero.emailLabel,
	description: site.seo.description,
	sameAs: site.networks.map((n) => n.href),
});
---

<Base>
	<script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />
	<Hero />
	<About />
	<WhatWeDo />
	<Team />
	<Community />
	<Faq />
	<Cta />
</Base>
